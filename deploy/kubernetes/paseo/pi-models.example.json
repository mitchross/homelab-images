{
  "providers": {
    "my-llm": {
      "baseUrl": "http://my-llm.example.svc.cluster.local:8000/v1",
      "api": "openai-completions",
      "apiKey": "$MY_LLM_API_KEY",
      "models": [
        {
          "id": "my-model",
          "name": "My local model",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": 32768,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
