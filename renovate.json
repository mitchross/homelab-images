{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "mise",
    "npm",
    "custom.regex"
  ],
  "timezone": "America/Detroit",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "weekly routine updates",
      "schedule": [
        "* 0-5 * * 1"
      ]
    },
    {
      "description": "CLIs that must match a running server: bump only after Omni, Talos or Kubernetes is upgraded.",
      "matchDepNames": [
        "siderolabs/omni",
        "siderolabs/talos",
        "kubernetes/kubernetes",
        "omnictl",
        "talosctl",
        "kubectl"
      ],
      "groupName": "cluster CLIs",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Merge only after the Omni server, Talos and Kubernetes in talos-argocd-proxmox run these versions."
      ]
    },
    {
      "description": "Review major upgrades separately from routine updates and each other.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    },
    {
      "description": "Strata is a fast-moving fork: bump the upstream commit only on approval, never automerge.",
      "matchDepNames": [
        "strata-upstream"
      ],
      "groupName": "strata upstream",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Also bump images/strata/VERSION in this PR to `<upstream CMakeLists version, padded to four numbers (0.1.57 -> 0.1.57.0)>-<first 7 of the new commit>-sm86` (drop any fifth image-revision number); the pin check fails until it matches. After the image publishes, Renovate opens the digest bump in talos-argocd-proxmox."
      ]
    },
    {
      "description": "vLLM patches must re-apply and pass smoke before any base bump.",
      "matchPackageNames": [
        "vllm/vllm-openai"
      ],
      "groupName": "vllm patched base",
      "labels": [
        "dependencies"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Bump images/vllm-qwen38-dualfast/VERSION and re-check all vendored patch anchors before merging."
      ]
    },
    {
      "matchPackageNames": ["club-3090-patches"],
      "groupName": "vllm club-3090 patches",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Re-vendor the three patch directories, update the Dockerfile revision label and bump VERSION; changing SOURCE_REF alone does not update patch code."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/.+/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\nARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "description": "Track the pinned upstream Strata commit.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/strata/SOURCE_REF$/"
      ],
      "matchStrings": [
        "^(?<currentDigest>[0-9a-f]{40})\\s*$"
      ],
      "depNameTemplate": "strata-upstream",
      "packageNameTemplate": "https://github.com/Niko1221/Strata",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    },
    {
      "description": "Track the vendored club-3090 patch source for manual review.",
      "customType": "regex",
      "managerFilePatterns": ["/^images/vllm-qwen38-dualfast/SOURCE_REF$/"],
      "matchStrings": ["^(?<currentDigest>[0-9a-f]{40})\\s*$"],
      "depNameTemplate": "club-3090-patches",
      "packageNameTemplate": "https://github.com/noonghunna/club-3090",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    }
  ],
  "dependencyDashboard": true
}
