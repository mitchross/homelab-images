{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "mise",
    "npm",
    "custom.regex"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchDepNames": [
        "@anthropic-ai/claude-code",
        "@openai/codex",
        "@earendil-works/pi-coding-agent"
      ],
      "groupName": "coding agents",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "CLIs that must match a running server: bump only after Omni, Talos or Kubernetes is upgraded.",
      "matchDepNames": [
        "siderolabs/omni",
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "groupName": "cluster CLIs",
      "automerge": false,
      "prBodyNotes": [
        "Merge only after the Omni server, Talos and Kubernetes in talos-argocd-proxmox run these versions."
      ]
    },
    {
      "description": "Language toolchains in hermes-dev.",
      "matchDepNames": [
        "go",
        "rust-lang/rust",
        "rust-lang/rustup"
      ],
      "groupName": "toolchains"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/.+/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\nARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "dependencyDashboard": true
}
